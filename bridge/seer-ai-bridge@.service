[Unit]
Description=Seer local assistant bridge (%i)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/srrs
EnvironmentFile=-%h/.config/seer/ai-bridge-%i.env
ExecStart=/usr/bin/env node /absolute/path/to/srrs/bridge/seer-ai-bridge.mjs --config %h/.config/seer/ai-bridge-%i.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
