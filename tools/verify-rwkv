#!/usr/bin/env bash
# The required RWKV check. Builds the artifact into rwkv-engine/dist and the
# native engine's output on the fixture beside it, runs the engine's tests
# against the committed fork golden, then every Node test. Fails on a
# failure, a missing input, or any skipped test. The fork golden itself is
# regenerated by rwkv-engine/parity/run.sh.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
dist=$root/rwkv-engine/dist
unset RWKV_ARTIFACT_OPTIONAL

"$root/tools/build-rwkv-artifact" "$dist"
(
  cd "$root/rwkv-engine"
  cargo run --quiet --locked --release --example predict -- \
    "$dist/weights.bin" tests/fixtures/revlog.json >"$dist/native-r.json"
  RWKV_WEIGHTS=$dist/weights.bin cargo test --quiet --locked --release -- --nocapture
)
out=$(cd "$root" && RWKV_ARTIFACT_DIR=$dist node --test tools/*.test.mjs 2>&1) || {
  echo "$out"
  exit 1
}
echo "$out" | grep -E '^ℹ (tests|pass|fail|skipped) |max \||page thread'
echo "$out" | grep -qx 'ℹ skipped 0' || {
  echo "FAIL: a Node test was skipped" >&2
  exit 1
}
